---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection, getEntry, render } from 'astro:content';

const base = import.meta.env.BASE_URL;
const homePage = await getEntry('pages', 'home');
const { Content: HomeContent } = await render(homePage);
const performances = await getCollection('performances', ({ data }) => !data.draft);
const recentArchive = performances
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// Featured media items for homepage preview
const allVideos = await getCollection('videos', ({ data }) => !data.draft && data.featured);
const allGalleries = await getCollection('galleries', ({ data }) => !data.draft && data.featured);
const allWords = await getCollection('words', ({ data }) => !data.draft && data.featured);

// Interleave featured videos, galleries and words, up to 2 items total
const featuredMedia = [
  ...allVideos.map(v => ({ type: 'video' as const, item: v })),
  ...allGalleries.map(g => ({ type: 'gallery' as const, item: g })),
  ...allWords.map(w => ({ type: 'words' as const, item: w })),
].sort((a, b) => new Date(b.item.data.date).getTime() - new Date(a.item.data.date).getTime())
 .slice(0, 3);

function youtubeThumbnail(embedUrl: string) {
  const match = embedUrl.match(/youtube\.com\/embed\/([^?]+)/);
  return match ? `https://img.youtube.com/vi/${match[1]}/hqdefault.jpg` : '';
}

function titleHtml(title: string) {
  return title.replace(/[*_](.*?)[*_]/g, '<em>$1</em>');
}
---

<BaseLayout title="Music in the Flesh">

  <!-- Hero -->
  <section class="hero section--parchment">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 class="hero__title">
          <span class="hero__title-music">Music</span>
          <span class="hero__title-in">in the</span>
          <span class="hero__title-flesh">Flesh</span>
        </h1>
        <p class="hero__subtitle display-subtitle">History, Performance, Experiment</p>
        <p class="hero__intro">{homePage.data.hero_intro}</p>
        <div class="hero__actions">
          <a href={`${base}about-project`} class="btn btn--crimson">About</a>
          <a href={`${base}media`} class="btn btn--ink">Media</a>
          <a href={`${base}about`} class="btn btn--ink">Biographies</a>
        </div>
      </div>
      <div class="hero__right">
        <div class="hero__book-row">
          <a href={`${base}book`} class="hero__book-link">
            <img
              src={`${base}images/book-cover.jpg`}
              alt="Music in the Flesh — An Early Modern Musical Physiology, by Bettina Varwig"
              class="hero__cover"
            />
          </a>
          <div class="hero__book-info">
            <p class="hero__book-title">Music in the Flesh</p>
            <p class="hero__award">Winner, Otto Kinkeldey Award, American Musicological Society</p>
            <a href={`${base}book`} class="hero__book-more">Buy or read more →</a>
          </div>
        </div>
        <hr class="rule rule--kraft hero__divider" />
        <a href={`${base}media/videos/bach-in-the-flesh`} class="hero__video-link">
          <div class="hero__video-thumb">
            <img src={`${base}images/uploads/bachinthefleshedit_poster.jpg`} alt="Bach in the Flesh — documentary film" />
            <span class="hero__video-play">▶</span>
          </div>
          <p class="label hero__video-label">Video</p>
          <p class="hero__video-caption">Watch: <em>Bach in the Flesh</em></p>
        </a>
      </div>
    </div>
  </section>

  <!-- Book description -->
  <section class="section">
    <div class="container container--prose">
      <div class="prose"><HomeContent /></div>
    </div>
  </section>

  <!-- Media preview -->
  {featuredMedia.length > 0 && (
    <section class="section section--parchment">
      <div class="container">
        <h2 class="section-heading">Media</h2>
        <hr class="rule rule--crimson" />
        <div class="media-preview">
          {featuredMedia.map(({ type, item }) => {
            const href = type === 'video'
              ? `${base}media/videos/${item.id}`
              : type === 'gallery'
              ? `${base}media/photos/${item.id}`
              : item.id === 'music-in-the-flesh'
              ? `${base}book`
              : `${base}media/words/${item.id}`;
            const thumb = type === 'video'
              ? (item.data.thumbnail || ((item.data as any).embedUrl ? youtubeThumbnail((item.data as any).embedUrl) : ''))
              : type === 'gallery'
              ? (item.data as any).images?.[0]?.image
              : (item.data as any).cover;
            const typeLabel = type === 'video' ? 'Video' : type === 'gallery' ? 'Photography' : 'Words';
            return (
              <a href={href} class="media-preview__card">
                <div class={`media-preview__thumb${type === 'words' ? ' media-preview__thumb--portrait' : ''}`}>
                  {thumb && <img src={thumb} alt={item.data.title} />}
                  {type === 'video' && <span class="media-preview__play">▶</span>}
                </div>
                <p class="label media-preview__type" style="color: var(--color-crimson); margin-top: var(--space-xs);">
                  {typeLabel}
                </p>
                <p class="media-preview__title" set:html={titleHtml(item.data.title)} />
              </a>
            );
          })}
        </div>
        <a href={`${base}media`} class="btn btn--ink" style="margin-top: var(--space-md);">All media</a>
      </div>
    </section>
  )}

  <!-- Archive preview -->
  {recentArchive.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-heading">From the Archive</h2>
        {recentArchive.map(p => (
          <EventCard
            title={p.data.title}
            date={p.data.date}
            venue={p.data.venue}
            description={p.data.description}
            slug={p.id}
          />
        ))}
        <a href={`${base}archive`} class="btn btn--ink" style="margin-top: var(--space-sm);">View full archive</a>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--color-kraft);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 3fr 2fr;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .hero__kicker {
    margin-bottom: var(--space-sm);
  }

  .hero__title {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    flex-wrap: nowrap;
    line-height: 1;
    margin-bottom: 0.15em;
    gap: 0.25em;
  }

  .hero__title-music,
  .hero__title-flesh {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-crimson);
  }

  .hero__title-in {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.5vw, 2.5rem);
    color: var(--color-slate);
    white-space: nowrap;
  }

  .hero__subtitle {
    font-size: var(--size-lg);
    margin-bottom: var(--space-md);
  }

  .hero__intro {
    max-width: 54ch;
    margin-bottom: var(--space-md);
    color: var(--color-ink-light);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hero__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
    align-self: center;
  }

  .hero__book-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .hero__book-link {
    display: block;
    flex-shrink: 0;
  }

  .hero__cover {
    width: 140px;
    height: auto;
    box-shadow: 4px 6px 16px rgba(28, 21, 13, 0.25);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .hero__book-link:hover .hero__cover {
    box-shadow: 6px 10px 24px rgba(28, 21, 13, 0.4);
    transform: translateY(-2px);
    opacity: 1;
  }

  .hero__book-info {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .hero__book-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--size-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    line-height: 1.2;
  }

  .hero__award {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--size-xs);
    color: var(--color-ink-light);
    line-height: 1.4;
  }

  .hero__book-more {
    font-family: var(--font-display);
    font-size: var(--size-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-crimson);
    margin-top: 0.2em;
  }

  .hero__divider {
    margin: 0;
  }

  .hero__video-link {
    display: block;
    width: 75%;
    text-decoration: none;
    color: var(--color-ink);
    transition: opacity var(--transition);
  }

  .hero__video-link:hover {
    opacity: 0.85;
  }

  .hero__video-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-ink);
  }

  .hero__video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--color-cream);
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }

  .hero__video-label {
    color: var(--color-crimson);
    margin-top: var(--space-xs);
  }

  .hero__video-caption {
    font-family: var(--font-display);
    font-size: var(--size-sm);
    color: var(--color-ink-light);
    margin-top: 0.15em;
  }

  .section-heading {
    color: var(--color-crimson);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--size-xl);
    margin-bottom: 0.25em;
  }

  /* Media preview */
  .media-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .media-preview__card {
    display: block;
    color: var(--color-ink);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .media-preview__card:hover {
    opacity: 0.85;
  }

  .media-preview__thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background-color: var(--color-kraft);
    overflow: hidden;
  }

  .media-preview__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-preview__thumb--portrait {
    background-color: var(--color-parchment);
  }

  .media-preview__thumb--portrait img {
    object-fit: contain;
    object-position: center;
  }

  .media-preview__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: var(--color-cream);
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }

  .media-preview__title {
    font-family: var(--font-display);
    font-size: var(--size-md);
    font-weight: 600;
    margin-top: 0.25em;
  }

  @media (max-width: 768px) {
    .hero__inner {
      grid-template-columns: 1fr;
      padding-block: var(--space-xl);
    }

    .hero__right {
      display: none;
    }

    .hero__title {
      flex-wrap: wrap;
    }
  }
</style>
