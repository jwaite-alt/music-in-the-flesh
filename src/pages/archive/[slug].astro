---
import PageLayout from '../../layouts/PageLayout.astro';
import Slideshow from '../../components/Slideshow.astro';
import { getCollection, render } from 'astro:content';
import { getDefaultArchiveEvents } from '../../utils/archiveEvents';
import { inlineLinks, stripLinks } from '../../utils/inlineLinks';
const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const performances = await getCollection('performances', ({ data }) => !data.draft);
  const pastEvents = await getDefaultArchiveEvents();
  return [
    ...performances.map(p => ({
      params: { slug: p.id },
      props: { performance: p, fromEvent: false },
    })),
    ...pastEvents.map(({ slug, entry }) => ({
      params: { slug },
      props: { performance: entry, fromEvent: true },
    })),
  ];
}

const { performance, fromEvent } = Astro.props;
const { Content } = await render(performance);

const dateObj = new Date(performance.data.date);
const formattedDate = dateObj.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---

<PageLayout
  title={performance.data.title}
  heading={performance.data.title}
  subheading={`${formattedDate} · ${performance.data.venue}${performance.data.location ? ', ' + performance.data.location : ''}`}
  description={stripLinks(performance.data.description)}
>

  {fromEvent && (
    <div class="event-basic">
      {performance.data.image && (
        <img src={performance.data.image} alt={performance.data.imageAlt ?? ''} class="event-basic__image" />
      )}
      <p class="event-basic__desc" set:html={inlineLinks(performance.data.description)} />
    </div>
  )}

  {performance.data.images && performance.data.images.length > 0 && (
    <div style="margin-bottom: var(--space-lg);">
      <Slideshow
        images={performance.data.images.map(img => ({
          image: typeof img === 'string' ? img : img.image,
          caption: typeof img === 'string' ? undefined : img.caption,
        }))}
        title={performance.data.title}
      />
    </div>
  )}

  {(performance.data.videoUrl || performance.data.videoUrlH265) && (
    <div class="video-inline">
      <video controls preload="metadata" playsinline poster={performance.data.videoPoster}>
        {performance.data.videoUrlH265 && <source src={performance.data.videoUrlH265} type='video/mp4; codecs="hvc1"' />}
        {performance.data.videoUrl && <source src={performance.data.videoUrl} type="video/mp4" />}
      </video>
      {performance.data.videoCaption && (
        <p class="video-inline__caption">{performance.data.videoCaption}</p>
      )}
    </div>
  )}

  <div class="prose">
    <Content />
  </div>

  {performance.data.feedbackFormUrl && (
    <div class="feedback-cta" style="margin-top: var(--space-lg); padding: var(--space-md); background-color: var(--color-parchment);">
      <p class="label">Attended this performance?</p>
      <p style="margin-bottom: var(--space-sm);">We'd love to hear about your experience.</p>
      <a href={performance.data.feedbackFormUrl} class="btn btn--crimson" target="_blank" rel="noopener">
        Share your feedback
      </a>
    </div>
  )}

  <div style="margin-top: var(--space-xl);">
    <a href={`${base}archive`} class="btn btn--ink">&larr; Back to archive</a>
  </div>

</PageLayout>

<style>
  .event-basic {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    margin-bottom: var(--space-lg);
  }

  .event-basic__image {
    flex-shrink: 0;
    width: 200px;
    height: auto;
    display: block;
    box-shadow: 4px 6px 16px rgba(28, 21, 13, 0.2);
  }

  .event-basic__desc {
    flex: 1;
    min-width: 0;
    max-width: 60ch;
    color: var(--color-ink-light);
  }

  .event-basic__desc :global(a) {
    color: var(--color-crimson);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 600px) {
    .event-basic {
      flex-direction: column;
    }
    .event-basic__image {
      width: 180px;
    }
  }

  .video-inline {
    width: 33%;
    margin-bottom: var(--space-lg);
  }

  .video-inline video {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    background-color: var(--color-ink);
  }

  .video-inline__caption {
    font-size: var(--size-sm);
    color: var(--color-ink-light);
    font-style: italic;
    margin-top: 0.4em;
  }

  @media (max-width: 768px) {
    .video-inline {
      width: 100%;
    }
  }
</style>
