---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function titleHtml(title: string) {
  return title.replace(/[*_](.*?)[*_]/g, '<em>$1</em>');
}

function formatDate(date: string) {
  return new Date(date).toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<PageLayout
  title="Blog"
  heading="Blog"
  subheading="Notes and reflections from the project"
  description="Notes and reflections from the Music in the Flesh project."
>

  {posts.length === 0 && (
    <p class="blog-empty">The first post is on its way.</p>
  )}

  {posts.map(post => (
    <article class="blog-card">
      <p class="blog-card__date label">{formatDate(post.data.date)}</p>
      <h2 class="blog-card__title">
        <a href={`${base}blog/${post.id}`} set:html={titleHtml(post.data.title)} />
      </h2>
      {post.data.author && <p class="blog-card__author">{post.data.author}</p>}
      <p class="blog-card__desc">{post.data.description}</p>
      <a href={`${base}blog/${post.id}`} class="btn btn--crimson">Read more</a>
    </article>
  ))}

</PageLayout>

<style>
  .blog-empty {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-slate);
  }

  .blog-card {
    border-top: 1px solid var(--color-kraft);
    padding-block: var(--space-md);
  }

  .blog-card__date {
    color: var(--color-ink-light);
    margin-bottom: 0.25em;
  }

  .blog-card__title {
    font-size: var(--size-xl);
    color: var(--color-ink);
    margin-bottom: 0.25em;
  }

  .blog-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition);
  }

  .blog-card__title a:hover {
    color: var(--color-crimson);
    opacity: 1;
  }

  .blog-card__author {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-slate);
    margin-bottom: var(--space-sm);
  }

  .blog-card__desc {
    color: var(--color-ink-light);
    max-width: 60ch;
    margin-bottom: var(--space-sm);
  }
</style>
