---
import PageLayout from '../layouts/PageLayout.astro';
import { getEntry, render } from 'astro:content';
const base = import.meta.env.BASE_URL;
const projectPage = await getEntry('pages', 'about-project');
const { Content: ProjectContent } = await render(projectPage);
---

<PageLayout
  title="About the Project"
  heading="About the Project"
  subheading="Music in the Flesh – History, Performance, Experiment"
  description="About the Music in the Flesh project — connecting Bettina Varwig's scholarship with live performance experiments."
  narrow
>

  <div class="prose">
    <ProjectContent />
    <div style="margin-top: var(--space-lg); display: flex; gap: var(--space-sm); flex-wrap: wrap;">
      <a href={`${base}media`} class="btn btn--crimson">Media</a>
      <a href={`${base}about`} class="btn btn--ink">Biographies</a>
    </div>
  </div>

</PageLayout>

<style>
  .prose :global(img.snake-right) {
    float: right;
    width: 45%;
    margin: 0 0 var(--space-md) var(--space-md);
  }
  .prose :global(img.snake-left) {
    float: left;
    width: 45%;
    margin: 0 var(--space-md) var(--space-md) 0;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.prose img').forEach((img, i) => {
      img.classList.add(i % 2 === 0 ? 'snake-right' : 'snake-left');
    });
  });
</script>
