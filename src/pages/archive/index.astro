---
import PageLayout from '../../layouts/PageLayout.astro';
import EventCard from '../../components/EventCard.astro';
import EventsTabs from '../../components/EventsTabs.astro';
import { getCollection } from 'astro:content';
import { getDefaultArchiveEvents } from '../../utils/archiveEvents';

const performances = await getCollection('performances', ({ data }) => !data.draft);
const pastEvents = await getDefaultArchiveEvents();
const sorted = [
  ...performances.map(p => ({ slug: p.id, data: p.data })),
  ...pastEvents.map(({ slug, entry }) => ({ slug, data: { ...entry.data, featured: false } })),
].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<PageLayout
  title="Events — Archive"
  heading="Events"
  subheading="Past performances, events and experiments"
  description="A record of all past Music in the Flesh performances and research events."
>
  <EventsTabs slot="header" current="archive" />

  {sorted.map(p => (
    <EventCard
      title={p.data.title}
      date={p.data.date}
      venue={p.data.venue}
      description={p.data.description}
      slug={p.slug}
      tag={p.data.featured ? 'Featured' : undefined}
    />
  ))}

</PageLayout>
