---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const base = import.meta.env.BASE_URL;
const bookEntry = await getEntry('words', 'music-in-the-flesh');
const { Content: BookContent } = await render(bookEntry);
const book = bookEntry.data;
---

<BaseLayout title="The Book — Music in the Flesh">

  <header class="book-header section--parchment">
    <div class="container">
      <p class="label" style="color: var(--color-crimson); margin-bottom: 0.5em;">The Book</p>
      <h1 class="book-header__title">Music <em>in the</em> Flesh</h1>
      <p class="book-header__sub display-subtitle">An Early Modern Musical Physiology</p>
    </div>
  </header>

  <div class="container book-body">

    <div class="book-intro">

      <!-- Cover + buttons -->
      <div class="book-cover-wrap">
        {book.buy_url ? (
          <a href={book.buy_url} target="_blank" rel="noopener">
            <img
              src={`${base}${book.cover?.replace(/^\//, '')}`}
              alt={book.title}
              class="book-cover"
            />
          </a>
        ) : (
          <img
            src={`${base}${book.cover?.replace(/^\//, '')}`}
            alt={book.title}
            class="book-cover"
          />
        )}
        {book.award && <p class="book-award" set:html={book.award.replace(',', ',<br/>')} />}
        <div class="book-actions">
          {book.buy_url && (
            <a href={book.buy_url} target="_blank" rel="noopener" class="btn btn--crimson">
              {book.buy_label ?? 'Buy'}
            </a>
          )}
          {book.download_url && (
            <a href={`${base}${book.download_url.replace(/^\//, '')}`} class="btn btn--ink" download>
              {book.download_label ?? 'Download'}
            </a>
          )}
        </div>
      </div>

      <!-- Description -->
      <div class="book-details">
        <p class="book-meta label">Bettina Varwig · University of Chicago Press, 2023</p>
        <div class="prose book-prose">
          <BookContent />
        </div>
      </div>

    </div>

  </div>

</BaseLayout>

<style>
  .book-header {
    border-bottom: 1px solid var(--color-kraft);
    padding-block: var(--space-lg);
  }

  .book-header__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--size-3xl);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-crimson);
    line-height: 1;
    margin-bottom: 0.2em;
  }

  .book-header__title em {
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: var(--color-slate);
    letter-spacing: 0.02em;
  }

  .book-header__sub {
    font-size: var(--size-lg);
    margin-top: 0.3em;
  }

  .book-body {
    padding-block: var(--space-xl);
  }

  .book-intro {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .book-cover-wrap {
    flex-shrink: 0;
  }

  .book-cover {
    width: 280px;
    height: auto;
    box-shadow: 8px 12px 32px rgba(28, 21, 13, 0.25);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .book-cover-wrap a:hover .book-cover {
    box-shadow: 12px 18px 40px rgba(28, 21, 13, 0.4);
    transform: translateY(-3px);
    opacity: 1;
  }

  .book-award {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--size-sm);
    color: var(--color-ink-light);
    text-align: center;
    margin-top: var(--space-sm);
    line-height: 1.4;
    max-width: 280px;
  }

  .book-meta {
    margin-bottom: var(--space-md);
  }

  .book-prose {
    max-width: 68ch;
  }

  .book-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    width: 280px;
  }

  .book-actions .btn {
    text-align: center;
    width: 100%;
  }

  @media (max-width: 768px) {
    .book-intro {
      grid-template-columns: 1fr;
    }

    .book-cover {
      width: 100%;
      max-width: 280px;
    }

    .book-cover-wrap {
      text-align: center;
      margin-inline: auto;
    }

    .book-award {
      margin-inline: auto;
    }
  }
</style>
