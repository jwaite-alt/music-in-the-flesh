---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const allVideos = (await getCollection('videos', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allGalleries = (await getCollection('galleries', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allWords = (await getCollection('words', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function youtubeThumbnail(embedUrl: string) {
  const match = embedUrl.match(/youtube\.com\/embed\/([^?]+)/);
  return match ? `https://img.youtube.com/vi/${match[1]}/hqdefault.jpg` : '';
}

function titleHtml(title: string) {
  return title.replace(/[*_](.*?)[*_]/g, '<em>$1</em>');
}
---

<BaseLayout title="Media — Music in the Flesh">

  <header class="page-header section--parchment">
    <div class="container">
      <h1 class="page-header__title">Media</h1>
    </div>
  </header>

  <div class="container media-body">

    <!-- Videos -->
    <section class="media-section" id="videos">
      <h2 class="media-section__heading">
        <span class="label">Videos</span>
      </h2>
      <hr class="rule rule--crimson" />
      {allVideos.length > 0 ? (
        <div class="media-grid">
          {allVideos.map(v => {
            const thumb = v.data.thumbnail || youtubeThumbnail(v.data.embedUrl);
            return (
              <a href={`${base}media/videos/${v.id}`} class="media-card">
                <div class="media-card__thumb">
                  {thumb && <img src={thumb} alt={v.data.title} />}
                  <span class="media-card__play">▶</span>
                </div>
                <p class="media-card__title" set:html={titleHtml(v.data.title)} />
                <p class="media-card__desc">{v.data.description}</p>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="media-placeholder">Video documentation will be added here.</p>
      )}
    </section>

    <!-- Photos -->
    <section class="media-section" id="photos">
      <h2 class="media-section__heading">
        <span class="label">Photos</span>
      </h2>
      <hr class="rule rule--crimson" />
      {allGalleries.length > 0 ? (
        <div class="media-grid">
          {allGalleries.map(g => (
            <a href={`${base}media/photos/${g.id}`} class="media-card">
              <div class="media-card__thumb">
                {g.data.images[0] && <img src={g.data.images[0].image} alt={g.data.title} />}
              </div>
              <p class="media-card__title" set:html={titleHtml(g.data.title)} />
              <p class="media-card__desc">{g.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="media-placeholder">Photography will be added here.</p>
      )}
    </section>

    <!-- Words -->
    <section class="media-section" id="words">
      <h2 class="media-section__heading">
        <span class="label">Words</span>
      </h2>
      <hr class="rule rule--crimson" />
      {allWords.length > 0 ? (
        <div class="words-list">
          {allWords.map(w => {
            const href = w.id === 'music-in-the-flesh'
              ? `${base}book`
              : `${base}media/words/${w.id}`;
            return (
              <div class="words-teaser">
                {w.data.cover && (
                  <a href={href} class="words-teaser__cover-link">
                    <img src={w.data.cover} alt={w.data.title} class="words-teaser__cover" />
                  </a>
                )}
                <div class="words-teaser__text">
                  <p class="words-teaser__title" set:html={titleHtml(w.data.title)} />
                  <p class="words-teaser__desc">{w.data.description}</p>
                  <a href={href} class="btn btn--crimson" style="margin-top: var(--space-md);">Read more</a>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="media-placeholder">Written content will be added here.</p>
      )}
    </section>

  </div>

</BaseLayout>

<script>
  async function sizeBookCover() {
    await document.fonts.ready;

    const link  = document.querySelector<HTMLElement>('.book-preview__cover-link');
    const cover = document.querySelector<HTMLImageElement>('.book-preview__cover');
    const text  = document.querySelector<HTMLElement>('.book-preview__text');
    if (!link || !cover || !text) return;

    // Wait for image to load so naturalWidth/Height are available
    if (!cover.complete) {
      await new Promise(r => cover.addEventListener('load', r, { once: true }));
    }

    const ratio = cover.naturalWidth / cover.naturalHeight; // e.g. ~0.69 for this cover

    // Iterate: setting link width changes text column width → changes text height
    // → changes required image width. 3 passes converges completely.
    link.style.width = '';
    for (let i = 0; i < 3; i++) {
      const textH = text.getBoundingClientRect().height;
      link.style.width = Math.round(textH * ratio) + 'px';
      void link.offsetWidth; // force reflow before next measurement
    }
  }

  sizeBookCover();
  window.addEventListener('resize', sizeBookCover);
</script>


<style>
  .page-header {
    border-bottom: 1px solid var(--color-kraft);
    padding-block: var(--space-lg);
  }

  .page-header__title {
    color: var(--color-crimson);
    font-size: var(--size-3xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .media-body {
    padding-block: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .media-section__heading {
    margin-bottom: var(--space-sm);
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .media-card {
    display: block;
    color: var(--color-ink);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .media-card:hover {
    opacity: 0.85;
  }

  .media-card__thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background-color: var(--color-parchment);
    overflow: hidden;
    margin-bottom: var(--space-xs);
  }

  .media-card__thumb--portrait img {
    object-fit: contain;
    object-position: center;
  }

  .media-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-card__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: var(--color-cream);
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
    opacity: 0.85;
  }

  .media-card__title {
    font-family: var(--font-display);
    font-size: var(--size-md);
    font-weight: 600;
    margin-bottom: 0.25em;
  }

  .media-card__desc {
    font-size: var(--size-sm);
    color: var(--color-ink-light);
  }

  .media-placeholder {
    color: var(--color-ink-light);
    font-style: italic;
    padding-block: var(--space-md);
  }

  /* Words teaser list */
  .words-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-top: var(--space-md);
  }

  .words-teaser {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .words-teaser__cover-link {
    flex-shrink: 0;
    display: block;
  }

  .words-teaser__cover {
    width: 160px;
    height: auto;
    display: block;
    box-shadow: 4px 6px 16px rgba(28, 21, 13, 0.2);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .words-teaser__cover-link:hover .words-teaser__cover {
    box-shadow: 6px 10px 24px rgba(28, 21, 13, 0.35);
    transform: translateY(-2px);
    opacity: 1;
  }

  .words-teaser__text {
    flex: 1;
    min-width: 0;
  }

  .words-teaser__title {
    font-family: var(--font-display);
    font-size: var(--size-lg);
    font-weight: 600;
    margin-bottom: 0.4em;
    color: var(--color-ink);
  }

  .words-teaser__desc {
    color: var(--color-ink-light);
    max-width: 60ch;
  }

  @media (max-width: 600px) {
    .words-teaser {
      flex-direction: column;
    }
    .words-teaser__cover {
      width: 140px;
    }
  }

  .book-preview {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    margin-top: var(--space-md);
  }

  .book-preview__cover-link {
    flex-shrink: 0;
    display: block;
  }

  .book-preview__cover {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 4px 6px 16px rgba(28, 21, 13, 0.2);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .book-preview__cover-link:hover .book-preview__cover {
    box-shadow: 6px 10px 24px rgba(28, 21, 13, 0.35);
    transform: translateY(-2px);
    opacity: 1;
  }

  .book-preview__text {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 600px) {
    .book-preview {
      flex-direction: column;
    }

    .book-preview__cover-link {
      width: 180px !important;
    }
  }
</style>
